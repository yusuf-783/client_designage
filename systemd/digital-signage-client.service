[Unit]
Description=Digital Signage Raspberry Pi Client Daemon
After=network-online.target sound.target graphical.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/digital-signage/client
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:0
ExecStart=/home/pi/digital-signage/client/.venv/bin/python -m app.main
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
